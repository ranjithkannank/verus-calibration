{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uns58M1VxZDZAy3QgBcJYh","type":"tool_result","content":"1\t// Exercise 3: verified Byzantine quorum check.\n2\t//\n3\t// Given a Vec<NodeId> of voters (may contain duplicates) and a total node\n4\t// count n, return true iff the distinct voters constitute a Byzantine\n5\t// quorum: at least (2n/3 + 1) distinct ids, all within range 0..n.\n6\t//\n7\t// The interesting obligation is relating an algorithmic distinct-count\n8\t// (which must walk the Vec) to the mathematical Set::len(). This is the\n9\t// concrete-matches-abstract gap that scales the worst on bigger projects.\n10\t//\n11\t// The spec below is FROZEN. Iteration cap: 20. See AGENTS.md.\n12\t\n13\tuse vstd::prelude::*;\n14\t\n15\tverus! {\n16\t\n17\tpub type NodeId = u32;\n18\t\n19\tpub open spec fn all_in_range(voters: Seq<NodeId>, n: u32) -> bool {\n20\t    forall|i: int| 0 <= i < voters.len() ==> (voters[i] as int) < (n as int)\n21\t}\n22\t\n23\tpub open spec fn distinct_count(voters: Seq<NodeId>) -> nat {\n24\t    voters.to_set().len()\n25\t}\n26\t\n27\tpub open spec fn byzantine_threshold(n: u32) -> nat {\n28\t    ((2 * (n as nat)) / (3 as nat) + (1 as nat)) as nat\n29\t}\n30\t\n31\t// Helper lemma: subrange(0, i+1) == subrange(0, i).push(s[i])\n32\tproof fn lemma_prefix_extend(s: Seq<NodeId>, i: int)\n33\t    requires 0 <= i < s.len(),\n34\t    ensures s.subrange(0, i + 1) =~= s.subrange(0, i).push(s[i]),\n35\t{\n36\t    assert forall|j: int| 0 <= j < s.subrange(0, i + 1).len() implies\n37\t        s.subrange(0, i + 1)[j] == s.subrange(0, i).push(s[i])[j]\n38\t    by {\n39\t        if j < i {\n40\t            // s.subrange(0, i+1)[j] == s[j] == s.subrange(0, i)[j] == s.subrange(0,i).push(s[i])[j]\n41\t        } else {\n42\t            // j == i: s.subrange(0, i+1)[i] == s[i] == s.subrange(0,i).push(s[i])[i]\n43\t        }\n44\t    };\n45\t}\n46\t\n47\t// Helper lemma: s.push(x).to_set() == s.to_set().insert(x)\n48\tproof fn lemma_push_to_set(s: Seq<NodeId>, x: NodeId)\n49\t    ensures s.push(x).to_set() =~= s.to_set().insert(x),\n50\t{\n51\t    assert forall|y: NodeId|\n52\t        s.push(x).to_set().contains(y) <==> s.to_set().insert(x).contains(y)\n53\t    by {\n54\t        // Both sides reduce to: s.contains(y) || y == x\n55\t        // s.push(x).to_set().contains(y) iff s.push(x).contains(y) (by axiom_seq_to_set_contains)\n56\t        // s.push(x).contains(y) iff (s.contains(y) || y == x) (by push definition + contains)\n57\t        // s.to_set().insert(x).contains(y) iff (s.to_set().contains(y) || y == x)\n58\t        //   iff (s.contains(y) || y == x) (by axiom_seq_to_set_contains)\n59\t        //\n60\t        // Forward: s.push(x).to_set().contains(y) ==> s.to_set().insert(x).contains(y)\n61\t        if s.push(x).to_set().contains(y) {\n62\t            assert(s.push(x).contains(y));\n63\t            if y == x {\n64\t                // s.to_set().insert(x).contains(x) is trivially true\n65\t            } else {\n66\t                // y != x, so y must be in s\n67\t                let j = choose|j: int| 0 <= j < s.push(x).len() && s.push(x)[j] == y;\n68\t                if j < s.len() {\n69\t                    assert(s[j] == y);\n70\t                    assert(s.contains(y));\n71\t                } else {\n72\t                    // j == s.len(), so s.push(x)[j] == x == y, contradicts y != x\n73\t                    assert(s.push(x)[s.len() as int] == x);\n74\t                    assert(false);\n75\t                }\n76\t            }\n77\t        }\n78\t        // Backward: s.to_set().insert(x).contains(y) ==> s.push(x).to_set().contains(y)\n79\t        if s.to_set().insert(x).contains(y) {\n80\t            if y == x {\n81\t                // s.push(x) has x as its last element\n82\t                assert(s.push(x)[s.len() as int] == x);\n83\t                assert(s.push(x).contains(x));\n84\t            } else {\n85\t                // y in s.to_set(), so y in s\n86\t                assert(s.to_set().contains(y));\n87\t                assert(s.contains(y));\n88\t                // y is in s, so in s.push(x) too\n89\t                let j = choose|j: int| 0 <= j < s.len() && s[j] == y;\n90\t                assert(s.push(x)[j] == s[j]);\n91\t                assert(s.push(x).contains(y));\n92\t            }\n93\t        }\n94\t    };\n95\t    assert(s.push(x).to_set() =~= s.to_set().insert(x));\n96\t}\n97\t\n98\t// Helper lemma: s.to_set() is finite\n99\tproof fn lemma_to_set_finite(s: Seq<NodeId>)\n100\t    ensures s.to_set().finite(),\n101\t{\n102\t    // This follows from the vstd axiom: axiom_seq_to_set_finite\n103\t}\n104\t\n105\t// Helper lemma: inserting x not in s increases len by 1\n106\tproof fn lemma_set_insert_new_len(s: Set<NodeId>, x: NodeId)\n107\t    requires s.finite(), !s.contains(x),\n108\t    ensures s.insert(x).len() == s.len() + 1,\n109\t{\n110\t    vstd::set::axiom_set_insert_len(s, x);\n111\t}\n112\t\n113\t// Helper lemma: inserting x already in s keeps same set\n114\tproof fn lemma_set_insert_existing(s: Set<NodeId>, x: NodeId)\n115\t    requires s.finite(), s.contains(x),\n116\t    ensures s.insert(x) =~= s,\n117\t{\n118\t    assert forall|y: NodeId| s.insert(x).contains(y) <==> s.contains(y) by {\n119\t        // If y == x: both sides true (s.contains(x) is true)\n120\t        // If y != x: s.insert(x).contains(y) iff s.contains(y) (by insert axiom)\n121\t    };\n122\t}\n123\t\n124\tpub fn is_byzantine_quorum(voters: &Vec<NodeId>, n: u32) -> (result: bool)\n125\t    requires\n126\t        n > 0,\n127\t        all_in_range(voters@, n),\n128\t    ensures\n129\t        result == (distinct_count(voters@) >= byzantine_threshold(n)),\n130\t{\n131\t    // Initialize bitmap: seen[k] == true iff k has been seen in voters[0..i)\n132\t    let mut seen: Vec<bool> = vec![false; n as usize];\n133\t\n134\t    // The vec macro gives us these specs:\n135\t    assert(seen@.len() == n as nat);\n136\t    assert(forall|k: int| 0 <= k < n as int ==> seen@[k] == false);\n137\t\n138\t    let mut count: u64 = 0;\n139\t    let mut i: usize = 0;\n140\t\n141\t    while i < voters.len()\n142\t        invariant\n143\t            // (a) cursor and bitmap bounds\n144\t            i <= voters@.len(),\n145\t            seen@.len() == n as nat,\n146\t            n > 0,\n147\t            // (b) re-carry the precondition\n148\t            all_in_range(voters@, n),\n149\t            // (c) bitmap abstraction: seen[k] iff k appears in prefix voters[0..i)\n150\t            forall|k: int| 0 <= k < n as int ==>\n151\t                (seen@[k] == voters@.subrange(0, i as int).contains(k as NodeId)),\n152\t            // (d) counter abstraction: count == |to_set of prefix|\n153\t            count as nat == voters@.subrange(0, i as int).to_set().len(),\n154\t            // (e) sanity bound\n155\t            count as nat <= n as nat,\n156\t        decreases voters@.len() - i,\n157\t    {\n158\t        let v_id: NodeId = voters[i];\n159\t        let v: usize = v_id as usize;\n160\t\n161\t        // v < n from all_in_range\n162\t        assert((voters@[i as int] as int) < n as int);\n163\t        assert(v_id == voters@[i as int]);\n164\t\n165\t        let ghost pref_old = voters@.subrange(0, i as int);\n166\t        let ghost v_ghost: NodeId = voters@[i as int];\n167\t\n168\t        // v_ghost as int equals v as int (since v = v_id as usize = v_ghost as usize)\n169\t        assert(v_ghost as int == v as int) by {\n170\t            assert(v_id == v_ghost);\n171\t            assert(v as int == v_id as int);\n172\t        };\n173\t\n174\t        if !seen[v] {\n175\t            // Case A: new voter – seen[v] == false, so v_ghost not in pref_old\n176\t\n177\t            let ghost count_old: u64 = count;\n178\t\n179\t            // From invariant (c) with k = v_ghost as int:\n180\t            assert(seen@[v_ghost as int] == pref_old.contains(v_ghost));\n181\t            assert(!pref_old.contains(v_ghost));\n182\t\n183\t            seen.set(v, true);\n184\t            count = count + 1;\n185\t            i = i + 1;\n186\t\n187\t            let ghost pref_new = voters@.subrange(0, i as int);\n188\t\n189\t            // pref_new == pref_old.push(v_ghost)\n190\t            assert(pref_new =~= pref_old.push(v_ghost)) by {\n191\t                lemma_prefix_extend(voters@, i as int - 1);\n192\t            };\n193\t\n194\t            // Re-establish (c): seen@[k] == pref_new.contains(k as NodeId)\n195\t            assert forall|k: int| 0 <= k < n as int implies\n196\t                (seen@[k] == pref_new.contains(k as NodeId))\n197\t            by {\n198\t                if k == v_ghost as int {\n199\t                    // seen@[v_ghost as int] is now true (we set it)\n200\t                    assert(seen@[v_ghost as int] == true);\n201\t                    // pref_new contains v_ghost at index pref_old.len()\n202\t                    assert(pref_new.contains(v_ghost)) by {\n203\t                        assert(0 <= pref_old.len() < pref_new.len());\n204\t                        assert(pref_new[pref_old.len() as int] == v_ghost);\n205\t                    };\n206\t                } else {\n207\t                    // seen@[k] is unchanged (frame property of Vec::set)\n208\t                    // pref_new.contains(k as NodeId) iff pref_old.contains(k as NodeId)\n209\t                    // because the only new element is v_ghost != k as NodeId\n210\t                    assert(seen@[k] == pref_old.contains(k as NodeId));\n211\t                    assert(pref_new.contains(k as NodeId) <==> pref_old.contains(k as NodeId)) by {\n212\t                        // Forward: if pref_new contains k as NodeId, find the witness\n213\t                        if pref_new.contains(k as NodeId) {\n214\t                            let j = choose|j: int| 0 <= j < pref_new.len() && pref_new[j] == (k as NodeId);\n215\t                            if j < pref_old.len() {\n216\t                                // pref_new[j] == pref_old[j] == k as NodeId\n217\t                                assert(pref_old[j] == k as NodeId);\n218\t                            } else {\n219\t                                // j == pref_old.len(), pref_new[j] == v_ghost\n220\t                                assert(pref_new[pref_old.len() as int] == v_ghost);\n221\t                                // But pref_new[j] == k as NodeId and v_ghost == k as NodeId\n222\t                                // contradicts k != v_ghost as int (since k < n <= u32::MAX)\n223\t                                assert(v_ghost == k as NodeId);\n224\t                                assert(v_ghost as int == k);\n225\t                                assert(false);\n226\t                            }\n227\t                        }\n228\t                        // Backward: if pref_old contains k as NodeId, same witness works in pref_new\n229\t                        if pref_old.contains(k as NodeId) {\n230\t                            let j = choose|j: int| 0 <= j < pref_old.len() && pref_old[j] == (k as NodeId);\n231\t                            assert(j < pref_new.len());\n232\t                            assert(pref_new[j] == pref_old[j]);\n233\t                        }\n234\t                    };\n235\t                }\n236\t            };\n237\t\n238\t            // Re-establish (d): count == pref_new.to_set().len()\n239\t            assert(count as nat == pref_new.to_set().len()) by {\n240\t                lemma_push_to_set(pref_old, v_ghost);\n241\t                // pref_new.to_set() == pref_old.to_set().insert(v_ghost)\n242\t                assert(pref_new.to_set() =~= pref_old.to_set().insert(v_ghost));\n243\t                // v_ghost not in pref_old.to_set()\n244\t                assert(!pref_old.to_set().contains(v_ghost));\n245\t                // So inserting increases len by 1\n246\t                lemma_to_set_finite(pref_old);\n247\t                lemma_set_insert_new_len(pref_old.to_set(), v_ghost);\n248\t                assert(pref_old.to_set().insert(v_ghost).len() == pref_old.to_set().len() + 1);\n249\t                // count = count_old + 1 = pref_old.to_set().len() + 1 = pref_new.to_set().len()\n250\t                assert(count_old as nat == pref_old.to_set().len());\n251\t            };\n252\t\n253\t            // (e): count = count_old + 1 <= n\n254\t            assert(count as nat <= n as nat);\n255\t\n256\t        } else {\n257\t            // Case B: duplicate voter – seen[v] == true, so v_ghost already in pref_old\n258\t\n259\t            let ghost count_old: u64 = count;\n260\t\n261\t            // From invariant (c) with k = v_ghost as int:\n262\t            assert(seen@[v_ghost as int] == pref_old.contains(v_ghost));\n263\t            assert(pref_old.contains(v_ghost));\n264\t\n265\t            i = i + 1;\n266\t\n267\t            let ghost pref_new = voters@.subrange(0, i as int);\n268\t\n269\t            // pref_new == pref_old.push(v_ghost)\n270\t            assert(pref_new =~= pref_old.push(v_ghost)) by {\n271\t                lemma_prefix_extend(voters@, i as int - 1);\n272\t            };\n273\t\n274\t            // Re-establish (c)\n275\t            assert forall|k: int| 0 <= k < n as int implies\n276\t                (seen@[k] == pref_new.contains(k as NodeId))\n277\t            by {\n278\t                if k == v_ghost as int {\n279\t                    assert(seen@[v_ghost as int] == true);\n280\t                    assert(pref_new.contains(v_ghost)) by {\n281\t                        assert(0 <= pref_old.len() < pref_new.len());\n282\t                        assert(pref_new[pref_old.len() as int] == v_ghost);\n283\t                    };\n284\t                } else {\n285\t                    assert(seen@[k] == pref_old.contains(k as NodeId));\n286\t                    assert(pref_new.contains(k as NodeId) <==> pref_old.contains(k as NodeId)) by {\n287\t                        if pref_new.contains(k as NodeId) {\n288\t                            let j = choose|j: int| 0 <= j < pref_new.len() && pref_new[j] == (k as NodeId);\n289\t                            if j < pref_old.len() {\n290\t                                assert(pref_old[j] == k as NodeId);\n291\t                            } else {\n292\t                                assert(pref_new[pref_old.len() as int] == v_ghost);\n293\t                                assert(v_ghost == k as NodeId);\n294\t                                assert(v_ghost as int == k);\n295\t                                assert(false);\n296\t                            }\n297\t                        }\n298\t                        if pref_old.contains(k as NodeId) {\n299\t                            let j = choose|j: int| 0 <= j < pref_old.len() && pref_old[j] == (k as NodeId);\n300\t                            assert(j < pref_new.len());\n301\t                            assert(pref_new[j] == pref_old[j]);\n302\t                        }\n303\t                    };\n304\t                }\n305\t            };\n306\t\n307\t            // Re-establish (d): count unchanged because v_ghost was already in the set\n308\t            assert(count as nat == pref_new.to_set().len()) by {\n309\t                lemma_push_to_set(pref_old, v_ghost);\n310\t                assert(pref_new.to_set() =~= pref_old.to_set().insert(v_ghost));\n311\t                assert(pref_old.to_set().contains(v_ghost));\n312\t                lemma_to_set_finite(pref_old);\n313\t                // Inserting existing element keeps same set (same len)\n314\t                lemma_set_insert_existing(pref_old.to_set(), v_ghost);\n315\t                assert(pref_old.to_set().insert(v_ghost) =~= pref_old.to_set());\n316\t                assert(pref_new.to_set().len() == pref_old.to_set().len());\n317\t                assert(count_old as nat == pref_old.to_set().len());\n318\t            };\n319\t        }\n320\t    }\n321\t\n322\t    // After loop: prefix(voters.len()) == voters@\n323\t    assert(voters@.subrange(0, voters@.len() as int) =~= voters@);\n324\t    assert(count as nat == distinct_count(voters@));\n325\t\n326\t    // Compute threshold: 2n/3 + 1\n327\t    let threshold: u64 = 2u64 * (n as u64) / 3u64 + 1u64;\n328\t    assert(threshold as nat == byzantine_threshold(n));\n329\t\n330\t    count >= threshold\n331\t}\n332\t\n333\t} // verus!\n334\t"}]},"parent_tool_use_id":null,"session_id":"344ae076-d406-465e-a149-63b85155dae0","uuid":"6489512d-78fa-45c8-8514-ffc42a8b96e1","timestamp":"2026-05-16T05:37:19.558Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/ranjith/Documents/projects/untitled folder/verus-calibration/exercises/quorum_count.rs","content":"// Exercise 3: verified Byzantine quorum check.\n//\n// Given a Vec<NodeId> of voters (may contain duplicates) and a total node\n// count n, return true iff the distinct voters constitute a Byzantine\n// quorum: at least (2n/3 + 1) distinct ids, all within range 0..n.\n//\n// The interesting obligation is relating an algorithmic distinct-count\n// (which must walk the Vec) to the mathematical Set::len(). This is the\n// concrete-matches-abstract gap that scales the worst on bigger projects.\n//\n// The spec below is FROZEN. Iteration cap: 20. See AGENTS.md.\n\nuse vstd::prelude::*;\n\nverus! {\n\npub type NodeId = u32;\n\npub open spec fn all_in_range(voters: Seq<NodeId>, n: u32) -> bool {\n    forall|i: int| 0 <= i < voters.len() ==> (voters[i] as int) < (n as int)\n}\n\npub open spec fn distinct_count(voters: Seq<NodeId>) -> nat {\n    voters.to_set().len()\n}\n\npub open spec fn byzantine_threshold(n: u32) -> nat {\n    ((2 * (n as nat)) / (3 as nat) + (1 as nat)) as nat\n}\n\n// Helper lemma: subrange(0, i+1) == subrange(0, i).push(s[i])\nproof fn lemma_prefix_extend(s: Seq<NodeId>, i: int)\n    requires 0 <= i < s.len(),\n    ensures s.subrange(0, i + 1) =~= s.subrange(0, i).push(s[i]),\n{\n    assert forall|j: int| 0 <= j < s.subrange(0, i + 1).len() implies\n        s.subrange(0, i + 1)[j] == s.subrange(0, i).push(s[i])[j]\n    by {\n        if j < i {\n            // s.subrange(0, i+1)[j] == s[j] == s.subrange(0, i)[j] == s.subrange(0,i).push(s[i])[j]\n        } else {\n            // j == i: s.subrange(0, i+1)[i] == s[i] == s.subrange(0,i).push(s[i])[i]\n        }\n    };\n}\n\n// Helper lemma: s.push(x).to_set() == s.to_set().insert(x)\nproof fn lemma_push_to_set(s: Seq<NodeId>, x: NodeId)\n    ensures s.push(x).to_set() =~= s.to_set().insert(x),\n{\n    assert forall|y: NodeId|\n        s.push(x).to_set().contains(y) <==> s.to_set().insert(x).contains(y)\n    by {\n        // Both sides reduce to: s.contains(y) || y == x\n        // s.push(x).to_set().contains(y) iff s.push(x).contains(y) (by axiom_seq_to_set_contains)\n        // s.push(x).contains(y) iff (s.contains(y) || y == x) (by push definition + contains)\n        // s.to_set().insert(x).contains(y) iff (s.to_set().contains(y) || y == x)\n        //   iff (s.contains(y) || y == x) (by axiom_seq_to_set_contains)\n        //\n        // Forward: s.push(x).to_set().contains(y) ==> s.to_set().insert(x).contains(y)\n        if s.push(x).to_set().contains(y) {\n            assert(s.push(x).contains(y));\n            if y == x {\n                // s.to_set().insert(x).contains(x) is trivially true\n            } else {\n                // y != x, so y must be in s\n                let j = choose|j: int| 0 <= j < s.push(x).len() && s.push(x)[j] == y;\n                if j < s.len() {\n                    assert(s[j] == y);\n                    assert(s.contains(y));\n                } else {\n                    // j == s.len(), so s.push(x)[j] == x == y, contradicts y != x\n                    assert(s.push(x)[s.len() as int] == x);\n                    assert(false);\n                }\n            }\n        }\n        // Backward: s.to_set().insert(x).contains(y) ==> s.push(x).to_set().contains(y)\n        if s.to_set().insert(x).contains(y) {\n            if y == x {\n                // s.push(x) has x as its last element\n                assert(s.push(x)[s.len() as int] == x);\n                assert(s.push(x).contains(x));\n            } else {\n                // y in s.to_set(), so y in s\n                assert(s.to_set().contains(y));\n                assert(s.contains(y));\n                // y is in s, so in s.push(x) too\n                let j = choose|j: int| 0 <= j < s.len() && s[j] == y;\n                assert(s.push(x)[j] == s[j]);\n                assert(s.push(x).contains(y));\n            }\n        }\n    };\n    assert(s.push(x).to_set() =~= s.to_set().insert(x));\n}\n\n// Helper lemma: s.to_set() is finite\nproof fn lemma_to_set_finite(s: Seq<NodeId>)\n    ensures s.to_set().finite(),\n{\n    // This follows from the vstd axiom: axiom_seq_to_set_finite\n}\n\n// Helper lemma: inserting x not in s increases len by 1\nproof fn lemma_set_insert_new_len(s: Set<NodeId>, x: NodeId)\n    requires s.finite(), !s.contains(x),\n    ensures s.insert(x).len() == s.len() + 1,\n{\n    vstd::set::axiom_set_insert_len(s, x);\n}\n\n// Helper lemma: inserting x already in s keeps same set\nproof fn lemma_set_insert_existing(s: Set<NodeId>, x: NodeId)\n    requires s.finite(), s.contains(x),\n    ensures s.insert(x) =~= s,\n{\n    assert forall|y: NodeId| s.insert(x).contains(y) <==> s.contains(y) by {\n        // If y == x: both sides true (s.contains(x) is true)\n        // If y != x: s.insert(x).contains(y) iff s.contains(y) (by insert axiom)\n    };\n}\n\npub fn is_byzantine_quorum(voters: &Vec<NodeId>, n: u32) -> (result: bool)\n    requires\n        n > 0,\n        all_in_range(voters@, n),\n    ensures\n        result == (distinct_count(voters@) >= byzantine_threshold(n)),\n{\n    // Initialize bitmap: seen[k] == true iff k has been seen in voters[0..i)\n    let mut seen: Vec<bool> = vec![false; n as usize];\n\n    // The vec macro gives us these specs:\n    assert(seen@.len() == n as nat);\n    assert(forall|k: int| 0 <= k < n as int ==> seen@[k] == false);\n\n    let mut count: u64 = 0;\n    let mut i: usize = 0;\n\n    while i < voters.len()\n        invariant\n            // (a) cursor and bitmap bounds\n            i <= voters@.len(),\n            seen@.len() == n as nat,\n            n > 0,\n            // (b) re-carry the precondition\n            all_in_range(voters@, n),\n            // (c) bitmap abstraction: seen[k] iff k appears in prefix voters[0..i)\n            forall|k: int| 0 <= k < n as int ==>\n                (seen@[k] == voters@.subrange(0, i as int).contains(k as NodeId)),\n            // (d) counter abstraction: count == |to_set of prefix|\n            count as nat == voters@.subrange(0, i as int).to_set().len(),\n            // (e) sanity bound\n            count as nat <= n as nat,\n        decreases voters@.len() - i,\n    {\n        let v_id: NodeId = voters[i];\n        let v: usize = v_id as usize;\n\n        // v < n from all_in_range\n        assert((voters@[i as int] as int) < n as int);\n        assert(v_id == voters@[i as int]);\n\n        let ghost pref_old = voters@.subrange(0, i as int);\n        let ghost v_ghost: NodeId = voters@[i as int];\n\n        // v_ghost as int equals v as int (since v = v_id as usize = v_ghost as usize)\n        assert(v_ghost as int == v as int) by {\n            assert(v_id == v_ghost);\n            assert(v as int == v_id as int);\n        };\n\n        if !seen[v] {\n            // Case A: new voter – seen[v] == false, so v_ghost not in pref_old\n\n            let ghost count_old: u64 = count;\n\n            // From invariant (c) with k = v_ghost as int:\n            assert(seen@[v_ghost as int] == pref_old.contains(v_ghost));\n            assert(!pref_old.contains(v_ghost));\n\n            seen.set(v, true);\n            count = count + 1;\n            i = i + 1;\n\n            let ghost pref_new = voters@.subrange(0, i as int);\n\n            // pref_new == pref_old.push(v_ghost)\n            assert(pref_new =~= pref_old.push(v_ghost)) by {\n                lemma_prefix_extend(voters@, i as int - 1);\n            };\n\n            // Re-establish (c): seen@[k] == pref_new.contains(k as NodeId)\n            assert forall|k: int| 0 <= k < n as int implies\n                (seen@[k] == pref_new.contains(k as NodeId))\n            by {\n                if k == v_ghost as int {\n                    // seen@[v_ghost as int] is now true (we set it)\n                    assert(seen@[v_ghost as int] == true);\n                    // pref_new contains v_ghost at index pref_old.len()\n                    assert(pref_new.contains(v_ghost)) by {\n                        assert(0 <= pref_old.len() < pref_new.len());\n                        assert(pref_new[pref_old.len() as int] == v_ghost);\n                    };\n                } else {\n                    // seen@[k] is unchanged (frame property of Vec::set)\n                    // pref_new.contains(k as NodeId) iff pref_old.contains(k as NodeId)\n                    // because the only new element is v_ghost != k as NodeId\n                    assert(seen@[k] == pref_old.contains(k as NodeId));\n                    assert(pref_new.contains(k as NodeId) <==> pref_old.contains(k as NodeId)) by {\n                        // Forward: if pref_new contains k as NodeId, find the witness\n                        if pref_new.contains(k as NodeId) {\n                            let j = choose|j: int| 0 <= j < pref_new.len() && pref_new[j] == (k as NodeId);\n                            if j < pref_old.len() {\n                                // pref_new[j] == pref_old[j] == k as NodeId\n                                assert(pref_old[j] == k as NodeId);\n                            } else {\n                                // j == pref_old.len(), pref_new[j] == v_ghost\n                                assert(pref_new[pref_old.len() as int] == v_ghost);\n                                // But pref_new[j] == k as NodeId and v_ghost == k as NodeId\n                                // contradicts k != v_ghost as int (since k < n <= u32::MAX)\n                                assert(v_ghost == k as NodeId);\n                                assert(v_ghost as int == k);\n                                assert(false);\n                            }\n                        }\n                        // Backward: if pref_old contains k as NodeId, same witness works in pref_new\n                        if pref_old.contains(k as NodeId) {\n                            let j = choose|j: int| 0 <= j < pref_old.len() && pref_old[j] == (k as NodeId);\n                            assert(j < pref_new.len());\n                            assert(pref_new[j] == pref_old[j]);\n                        }\n                    };\n                }\n            };\n\n            // Re-establish (d): count == pref_new.to_set().len()\n            assert(count as nat == pref_new.to_set().len()) by {\n                lemma_push_to_set(pref_old, v_ghost);\n                // pref_new.to_set() == pref_old.to_set().insert(v_ghost)\n                assert(pref_new.to_set() =~= pref_old.to_set().insert(v_ghost));\n                // v_ghost not in pref_old.to_set()\n                assert(!pref_old.to_set().contains(v_ghost));\n                // So inserting increases len by 1\n                lemma_to_set_finite(pref_old);\n                lemma_set_insert_new_len(pref_old.to_set(), v_ghost);\n                assert(pref_old.to_set().insert(v_ghost).len() == pref_old.to_set().len() + 1);\n                // count = count_old + 1 = pref_old.to_set().len() + 1 = pref_new.to_set().len()\n                assert(count_old as nat == pref_old.to_set().len());\n            };\n\n            // (e): count = count_old + 1 <= n\n            assert(count as nat <= n as nat);\n\n        } else {\n            // Case B: duplicate voter – seen[v] == true, so v_ghost already in pref_old\n\n            let ghost count_old: u64 = count;\n\n            // From invariant (c) with k = v_ghost as int:\n            assert(seen@[v_ghost as int] == pref_old.contains(v_ghost));\n            assert(pref_old.contains(v_ghost));\n\n            i = i + 1;\n\n            let ghost pref_new = voters@.subrange(0, i as int);\n\n            // pref_new == pref_old.push(v_ghost)\n            assert(pref_new =~= pref_old.push(v_ghost)) by {\n                lemma_prefix_extend(voters@, i as int - 1);\n            };\n\n            // Re-establish (c)\n            assert forall|k: int| 0 <= k < n as int implies\n                (seen@[k] == pref_new.contains(k as NodeId))\n            by {\n                if k == v_ghost as int {\n                    assert(seen@[v_ghost as int] == true);\n                    assert(pref_new.contains(v_ghost)) by {\n                        assert(0 <= pref_old.len() < pref_new.len());\n                        assert(pref_new[pref_old.len() as int] == v_ghost);\n                    };\n                } else {\n                    assert(seen@[k] == pref_old.contains(k as NodeId));\n                    assert(pref_new.contains(k as NodeId) <==> pref_old.contains(k as NodeId)) by {\n                        if pref_new.contains(k as NodeId) {\n                            let j = choose|j: int| 0 <= j < pref_new.len() && pref_new[j] == (k as NodeId);\n                            if j < pref_old.len() {\n                                assert(pref_old[j] == k as NodeId);\n                            } else {\n                                assert(pref_new[pref_old.len() as int] == v_ghost);\n                                assert(v_ghost == k as NodeId);\n                                assert(v_ghost as int == k);\n                                assert(false);\n                            }\n                        }\n                        if pref_old.contains(k as NodeId) {\n                            let j = choose|j: int| 0 <= j < pref_old.len() && pref_old[j] == (k as NodeId);\n                            assert(j < pref_new.len());\n                            assert(pref_new[j] == pref_old[j]);\n                        }\n                    };\n                }\n            };\n\n            // Re-establish (d): count unchanged because v_ghost was already in the set\n            assert(count as nat == pref_new.to_set().len()) by {\n                lemma_push_to_set(pref_old, v_ghost);\n                assert(pref_new.to_set() =~= pref_old.to_set().insert(v_ghost));\n                assert(pref_old.to_set().contains(v_ghost));\n                lemma_to_set_finite(pref_old);\n                // Inserting existing element keeps same set (same len)\n                lemma_set_insert_existing(pref_old.to_set(), v_ghost);\n                assert(pref_old.to_set().insert(v_ghost) =~= pref_old.to_set());\n                assert(pref_new.to_set().len() == pref_old.to_set().len());\n                assert(count_old as nat == pref_old.to_set().len());\n            };\n        }\n    }\n\n    // After loop: prefix(voters.len()) == voters@\n    assert(voters@.subrange(0, voters@.len() as int) =~= voters@);\n    assert(count as nat == distinct_count(voters@));\n\n    // Compute threshold: 2n/3 + 1\n    let threshold: u64 = 2u64 * (n as u64) / 3u64 + 1u64;\n    assert(threshold as nat == byzantine_threshold(n));\n\n    count >= threshold\n}\n\n} // verus!\n","numLines":334,"startLine":1,"totalLines":334}}}
